{
  "name": "the-everyday-table",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "test:content": "node --test tests/*.test.ts && node scripts/validate-content.ts",
    "check": "astro check",
    "build": "node scripts/validate-content.ts && astro build && pagefind --site dist",
    "test:e2e": "playwright test",
    "verify:output": "node scripts/verify-output.ts",
    "lint:docs": "markdownlint README.md AGENTS.md CLAUDE.md \"docs/**/*.md\" \".github/**/*.md\"",
    "preview": "astro preview",
    "photo:add": "node scripts/import-photo.ts",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.1",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "unified": "^11.0.5",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.58.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.0.0",
    "@types/unist": "^3.0.3",
    "markdownlint-cli": "^0.49.1",
    "pagefind": "^1.4.0",
    "typescript": "^6.0.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}