---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import BlogArticle from '../../components/BlogArticle.astro';
import { publishedPosts } from '../../lib/blog.ts';
export async function getStaticPaths() {
  return publishedPosts(await getCollection('blog')).map(post => ({
    params: { slug: post.data.slug }, props: { post },
  }));
}
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const featured = data.featured_recipe
  ? (await getCollection('recipes')).find(recipe => recipe.data.slug === data.featured_recipe) : undefined;
if (data.featured_recipe && !featured) throw new Error(`blog/${data.slug}: featured_recipe is not available`);
---
<SiteLayout title={data.title} description={data.description}>
  <BlogArticle post={data} featured={featured?.data}><Content /></BlogArticle>
</SiteLayout>
