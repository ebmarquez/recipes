---
import SiteLayout from '../layouts/SiteLayout.astro';
import BlogArticle from '../components/BlogArticle.astro';
import { readBlog } from '../lib/blog.ts';
import { readRecipes } from '../lib/read-recipes.ts';
import { renderBlog } from '../lib/recipe-markdown.ts';

if (!import.meta.env.DEV) throw new Error('Draft pages must never be generated in a production build');
if (!Astro.url.pathname.endsWith('/')) {
  return new Response(null, {
    status: 307,
    headers: { Location: `${Astro.url.pathname}/${Astro.url.search}`, 'Cache-Control': 'no-store' },
  });
}
Astro.response.headers.set('Cache-Control', 'no-store');
const recipes = await readRecipes();
const posts = await readBlog(undefined, recipes);
const drafts = posts.filter(post => post.data.publication_status === 'draft')
  .toSorted((a, b) => b.data.date_modified.localeCompare(a.data.date_modified) || a.data.slug.localeCompare(b.data.slug));
const post = Astro.params.slug ? drafts.find(post => Astro.params.slug === `blog/${post.data.slug}`) : undefined;
if (Astro.params.slug && !post) return new Response('Draft not found', { status: 404 });
const rendered = post ? await renderBlog(post, recipes, posts, import.meta.env.BASE_URL) : undefined;
const featured = post ? recipes.find(recipe => recipe.data.slug === post.data.featured_recipe && recipe.data.publication_status === 'published') : undefined;
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<SiteLayout title={post ? `${post.data.title} (draft)` : 'Local drafts'} description={post?.data.description ?? 'Review unpublished kitchen posts on this computer.'} noindex>
  {post && rendered ? <BlogArticle post={post.data} featured={featured?.data} draftPreview>
    <Fragment set:html={rendered.html} />
  </BlogArticle> : <section class="source-library wrapper">
    <h1>Local drafts</h1>
    <p class="notice">Development-only previews. Nothing here is published or included in the site build.</p>
    {drafts.length ? <ul class="recipe-grid">
      {drafts.map(({ data }) => <li class="recipe-card">
        <article>
          <p class="eyebrow">Draft</p>
          <h2 class="blog-card-title"><a href={`${home}local-drafts/blog/${data.slug}/`}>{data.title}</a></h2>
          <p>{data.description}</p>
        </article>
      </li>)}
    </ul> : <p>No blog drafts yet.</p>}
  </section>}
</SiteLayout>
